#!/bin/sh
set +e
T=/var/jb/usr/lib/TweakInject
M=/var/jb/Library/MobileSubstrate/DynamicLibraries
LOG=/var/mobile/cc18native_install.log
{
    echo "CC18Native install"
    ls -ld "$T" "$M" 2>&1
} > "$LOG" 2>&1
if [ -d "$T" ]; then
    RT=$(cd "$T" 2>/dev/null && pwd -P)
    RM=$(cd "$M" 2>/dev/null && pwd -P)
    echo "T=$RT" >> "$LOG"
    echo "M=$RM" >> "$LOG"
    if [ -n "$RT" ] && [ "$RT" != "$RM" ]; then
        ln -sf "$M/CC18Native.dylib" "$T/CC18Native.dylib"
        ln -sf "$M/CC18Native.plist" "$T/CC18Native.plist"
        echo "linked into TweakInject" >> "$LOG"
    fi
fi
killall -9 cfprefsd 2>/dev/null
K=/var/jb/usr/bin/killall
[ -x "$K" ] || K=/usr/bin/killall
[ -x "$K" ] || K=killall
"$K" -9 SpringBoard 2>/dev/null
exit 0
